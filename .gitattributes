# Normalize line endings for all text files
* text=auto

# Force LF for these file types regardless of OS
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.csv  text eol=lf

# Treat binaries as binary — no line ending conversion
*.xlsx binary
*.pdf  binary
*.docx binary
*.png  binary
*.jpg  binary
